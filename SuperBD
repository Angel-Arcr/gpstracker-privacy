        }

        p{
            line-height: 1.7;
        }

        .card{
            background-color: #1e1e1e;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 0 10px rgba(0,0,0,0.4);
        }

        footer{
            margin-top: 40px;
            text-align: center;
            color: #999;
            font-size: 14px;
        }

        a{
            color: #4da3ff;
        }
    </style>
